-- 1. Прикажите утакмице са више од 40.000 гледалаца у марту 2025. Колико их је?
SELECT CAST(kickoff_ts AS DATE) as datum, home_team, away_team,
    attendance
FROM matches_flat
WHERE attendance > 40000  and kickoff_ts >= '2025-03-01' and kickoff_ts < '2025-04-01'
ORDER BY datum;

-- 2025-03-15	Kingsbridge City	Dunmore Celtic	40486
-- 2025-03-29	Kingsbridge City	Oakfield Town	40139



