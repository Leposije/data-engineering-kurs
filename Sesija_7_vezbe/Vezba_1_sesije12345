-- Castlebrook United	8	10



-- 3. Колико играча је давало голове у обе сезоне?
SELECT count(*) as broj_igraca
FROM (SELECT e.player_id
    from match_events as e
    join matches as m ON m.match_id = e.match_id
    WHERE e.event_type in ('goal', 'own goal', 'penalty_goal')
    GROUP BY e.player_id
    HAVING COUNT(DISTINCT season) = 2);
-- 193 igraca je dalo gol u obe sezone






