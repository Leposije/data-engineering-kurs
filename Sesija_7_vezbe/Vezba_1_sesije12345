-- 1. Направите табелу лиге каква је била 1. јануара 2025. (сезона 2024/25) Ко је био на врху?


WITH team_matches AS (
SELECT season, home_team_id AS team_id,
home_goals AS goals_for, away_goals AS goals_against
FROM matches WHERE status = 'played' and kickoff_ts < '2025-01-01'
UNION ALL
SELECT season, away_team_id,
away_goals, home_goals
FROM matches WHERE status = 'played' and kickoff_ts <'2025-01-01'
)
SELECT t.team_name,
COUNT(*) AS played,
SUM(CASE WHEN goals_for > goals_against THEN 3
WHEN goals_for = goals_against THEN 1 ELSE 0 END) AS points,
SUM(goals_for - goals_against) AS goal_difference,
SUM(goals_for) AS goals_scored
FROM team_matches tm
JOIN teams t ON tm.team_id = t.team_id
WHERE tm.season = '2024/25'
GROUP BY t.team_name
ORDER BY points DESC, goal_difference DESC, goals_scored DESC

