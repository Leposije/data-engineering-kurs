-- 4. Прикажите утакмице без податка о посети или о времену: датум, тимове, посету и време, а уместо NULL нека пише 'непознато'. Колико их је?

SELECT CAST(kickoff_ts AS DATE) as datum, home_team, away_team,
    coalesce(CAST(attendance as String), 'nepoznato') as attendance,
    coalesce(CAst(kickoff_ts as string), 'nepoznato') as time
FROM matches_flat
WHERE attendance IS NULL OR kickoff_ts IS NULL
ORDER BY datum;

