-- 2. Који клубови су у сезони 2024/25 имали више победа у гостима него код куће?
SELECT team_name,
    home_win,
    away_win
FROM (SELECT team_name,
    SUM (CASE when m.home_team_id = t.team_id and home_goals>away_goals THEN 1 ELSE 0 END) as home_win,
    SUM (CASE when m.away_team_id = t.team_id and away_goals>home_goals THEN 1 ELSE 0 end) as away_win
FROM teams as t
JOIN matches as m ON t.team_id in (m.home_team_id, m.away_team_id)  
WHERE m.season = '2024/25'
GROUP BY team_name)
WHERE home_win < away_win;
