-- 1. За сваког судију прикажите националност (из referees), број утакмица, просечан број голова и проценат победа домаћина. Код ког судије домаћини најчешће побеђују?

SELECT  r.referee_name, r.nationality, 
    COUNT(*) as  broj_utakmica,
    ROUND(AVG(m.home_goals + m.away_goals), 2) as prosek_golova,
    ROUND(100.0 * SUM(CASE WHEN m.home_goals > m.away_goals THEN 1 ELSE 0 END) / COUNT(*),1)
    as procenat_domacin_win
FROM matches as m 
JOIN referees as r ON r.referee_id = m.referee_id
GROUP BY r.referee_id, r.referee_name, r.nationality
ORDER BY procenat_domacin_win DESC;

-- 19 sudija
