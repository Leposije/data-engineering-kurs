-- Osnovni nivo 

-- 1.Prikažite naziv svakog kluba i naziv stadiona na kojem igra
-- domaće utakmice.

SELECT t.team_name, s.stadium_name
FROM teams t
LEFT JOIN stadiums s ON s.stadium_id = t.stadium_id
ORDER BY t.team_name;
-- Ashford Rovers	Mill Lane
-- Brackley Athletic	Brackley Road
-- Brackley Harriers	Brackley Road

-- 2.Prikažite ime i prezime igrača i naziv kluba za koji je igrao u
-- sezoni 2024/25. Uklonite duplikate iz rezultata.
SELECT DISTINCT p.first_name, p.last_name, t.team_name
FROM player_match_stats s
JOIN matches m ON m.match_id = s.match_id
JOIN players p ON p.player_id = s.player_id
JOIN teams t   ON t.team_id   = s.team_id
WHERE m.season = '2024/25'
ORDER BY p.last_name, p.first_name;

-- 3.Prikažite datum odigravanja utakmice, naziv stadiona i broj
-- gledalaca za sve utakmice u sezoni 2024/25.

SELECT CAST(m.kickoff_ts AS DATE) as datum, s.stadium_name, m.attendance
    
FROM matches as m
JOIN stadiums as s ON s.stadium_id = m.stadium_id
WHERE m.season = '2024/25'
ORDER BY datum;

-- 380 odigranih utakmica


--Srednji nivo 

-- 1.Prikažite sve utakmice za koje nije evidentiran broj gledalaca.
-- Prikažite datum, domaći klub i gostujući klub.
SELECT CAST(m.kickoff_ts AS DATE) AS datum,
       th.team_name AS domacin,
       ta.team_name AS gost
FROM matches m
JOIN teams th ON th.team_id = m.home_team_id
JOIN teams ta ON ta.team_id = m.away_team_id
WHERE m.attendance IS NULL
ORDER BY datum;

-- 17 utakmica
-- 2023-08-19	Riverton Athletic	Valemont United
-- 2023-11-25	Castlebrook United	Pemberton United
-- 2023-12-03	Elmsworth Wanderers	Castlebrook United
-- 2023-12-16	Brackley Harriers	Riverton Athletic



-- 2.Pronađite stadione na kojima nije odigrana ni jedna utakmica
-- u sezoni 2024/25.

SELECT s.stadium_name, s.city
FROM stadiums s
LEFT JOIN matches m
       ON m.stadium_id = s.stadium_id
      AND m.season = '2024/25'
WHERE m.match_id IS NULL;

-- samo jedan stadion Fairhaven Lane u gradu Fairhaven



-- 3.Za svaki klub izračunajte ukupan broj žutih kartona koje su
-- dobili njegovi igrači u sezoni 2024/25. Rezultat sortirajte
-- opadajuće prema broju kartona.
SELECT t.team_name, COUNT(*) AS zuti_kartoni
FROM match_events e
JOIN matches m ON m.match_id = e.match_id
JOIN teams t   ON t.team_id  = e.team_id
WHERE m.season = '2024/25'
  AND e.event_type = 'yellow_card'
GROUP BY t.team_name
ORDER BY zuti_kartoni DESC;

-- Ashford Rovers	75 zutih kartona
-- Castlebrook United	74 zutih kartona
-- Stonebridge Rovers	69 zutih kartona
-- Kingsbridge City	68 zutih kartona
-- Thornbury City	68 zutih kartona


-- Napredni nivo
-- 1.Pronađite pet igrača sa najvećim brojem asistencija u
-- sezoni 2024/25. Prikažite ime igrača i broj asistencija.

SELECT p.first_name, p.last_name, COUNT(*) AS asistencije
FROM match_events e
JOIN matches m ON m.match_id = e.match_id
JOIN players p ON p.player_id = e.related_player_id
WHERE m.season = '2024/25'
  AND e.event_type = 'goal'
GROUP BY p.player_id, p.first_name, p.last_name
ORDER BY asistencije DESC, p.last_name
LIMIT 5;

-- Rezultat
-- Pablo	Fernández	9 asistencija
-- Lucas	Pereira	7 asistencija
-- Filip	Petrović	7 asistencija
-- Eirik	Solberg	7 asistencija
-- Kieran	Bradley	6 asistencija

--2.Pronađite tri igrača sa najvećim ukupnim brojem
-- odigranih minuta u sezoni 2024/25. Prikažite ime igrača,
-- klub i ukupan broj minuta.

SELECT p.first_name, p.last_name, t.team_name,
       SUM(s.minutes_played) AS ukupno_minuta
FROM player_match_stats s
JOIN matches m ON m.match_id = s.match_id
JOIN players p ON p.player_id = s.player_id
JOIN teams t   ON t.team_id   = s.team_id
WHERE m.season = '2024/25'
GROUP BY p.player_id, p.first_name, p.last_name, t.team_name
ORDER BY ukupno_minuta DESC, p.last_name
LIMIT 3;

-- Aaron	Lowe	Kingsbridge City	ukupan broj minuta 3240
-- Jonas	Müller	Westmere Town	ukupan broj minuta 3240
-- Ibrahima	Ndiaye	Ashford Rovers	ukupan broj minuta 3240



-- 3.Za svaku sezonu prikažite broj isključenja po klubovima.
-- Računajte događaje red_card i second_yellow. Uključite
-- samo klubove koji su imali najmanje jedno isključenje.


SELECT m.season, t.team_name, COUNT(*) AS iskljucenja
FROM match_events e
JOIN matches m ON m.match_id = e.match_id
JOIN teams t   ON t.team_id  = e.team_id
WHERE e.event_type IN ('red_card', 'second_yellow')
GROUP BY m.season, t.team_name
HAVING COUNT(*) >= 1
ORDER BY m.season, iskljucenja DESC;

-- 35 timova su imala bar jedno iskljucenje , tim sa najvise ima 5